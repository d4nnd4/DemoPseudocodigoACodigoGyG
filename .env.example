# ============================================================================
#  Proveedor de IA: ollama (local, gratis) | openai | anthropic
# ============================================================================
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1536          # tope de salida: evita respuestas interminables

# ---------------------------------------------------------------------------
#  Ollama (por defecto)
# ---------------------------------------------------------------------------
# Modelos sugeridos (de menor a mayor consumo):
#   qwen2.5-coder:0.5b  -> ~0.4 GB de RAM, muy rápido, calidad básica
#   qwen2.5-coder:1.5b  -> ~1.2 GB de RAM, buen balance para CPU (default)
#   qwen2.5-coder:3b    -> ~2.3 GB de RAM
#   qwen2.5-coder:7b    -> ~5 GB de RAM, mucho mejor (sube OLLAMA_MEM_LIMIT a 7g)
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_NUM_CTX=4096          # contexto: 2048 ahorra RAM si el pseudocódigo es corto
OLLAMA_KEEP_ALIVE=15m        # tras este tiempo sin uso el modelo sale de la RAM
OLLAMA_MEM_LIMIT=3g          # límite de memoria del contenedor de Ollama

# Disponibilidad del modelo: si la descarga falla o se corta, la interfaz avisa
# y el backend reintenta solo con backoff exponencial (min -> max segundos).
OLLAMA_RETRY_MIN_SECONDS=5
OLLAMA_RETRY_MAX_SECONDS=60
OLLAMA_PULL_STALL_SECONDS=120   # descarga sin avanzar este tiempo = se corta y reintenta
OLLAMA_WATCHDOG_SECONDS=60      # ya listo: cada cuánto se comprueba que el modelo siga ahí

# ---------------------------------------------------------------------------
#  Proveedores en la nube (demostrativo). Arrancar solo backend y frontend:
#     docker compose up --build backend frontend
# ---------------------------------------------------------------------------
# Cualquier API compatible con OpenAI (OpenAI, Groq, OpenRouter, Together,
# Mistral, o un servidor propio con vLLM / LM Studio):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=...
# OPENAI_MODEL=...           # nombre del modelo según el proveedor

# Anthropic (Claude):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=...        # ver docs.claude.com/en/docs/about-claude/models

# Espacio para OTRO modelo con API propia (plantilla: backend/app/providers/custom.py,
# guía: docs/OTRO_MODELO.md):
# LLM_PROVIDER=custom
# CUSTOM_BASE_URL=http://mi-servidor:9000
# CUSTOM_API_KEY=
# CUSTOM_MODEL=mi-modelo

# ============================================================================
#  Rutas de salvado
# ============================================================================
# Carpetas del HOST donde quedan los archivos (relativas a este directorio o absolutas,
# p. ej. /home/daniel/pseudo2code o C:/Users/daniel/pseudo2code en Docker Desktop).
GENERATED_HOST_DIR=./generated
LOGS_HOST_DIR=./logs

# Ruta de cada archivo dentro de GENERATED_HOST_DIR (sin extensión; se añade sola).
# Variables: {language} {direction} {id} {slug} {date} {year} {month}  — {id} es obligatorio.
CODE_PATH_TEMPLATE={language}/{id}_{slug}
PSEUDO_PATH_TEMPLATE=pseudocode/{language}/{id}_{slug}
PSEUDO_EXTENSION=txt
# Ejemplo: agrupar por fecha ->  CODE_PATH_TEMPLATE={year}/{month}/{language}/{id}_{slug}

LOG_LEVEL=INFO

# Puerto de la interfaz web
APP_PORT=8080
